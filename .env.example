APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sanctum SPA / cookie sessions: hostnames (and dev ports) that may send cookies to the API.
# Must include the exact origin you open in the browser (e.g. Vite on :5173 → add mysite.dev:5173).
# Example (adjust to your vhost): localhost,localhost:5173,127.0.0.1,127.0.0.1:5173,mysite.dev,mysite.dev:5173
# SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173

# CORS: comma-separated origins (exact URL each; no spaces after commas unless the whole value is quoted).
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com

# Dev vhosts mapped to localhost (comma-separated hostname only). Allows credentialed requests from http(s)://<host>:<any port>
# e.g. WAMP/virtual host pointing itqandev.com → 127.0.0.1 while Qwik runs on :5173
# CORS_DEV_HOST_NAMES=itqandev.com
# Browser preflight cache (seconds); production often uses 3600
# CORS_MAX_AGE=3600

# Rate limits (non-local). Tune under load / WAF.
# API_RATE_LIMIT_AUTHENTICATED_PER_MINUTE=300
# API_RATE_LIMIT_GUEST_PER_MINUTE=120
# UPLOAD_RATE_LIMIT_PER_MINUTE=30
# BULK_RATE_LIMIT_PER_MINUTE=10
# HEALTH_CHECK_RATE_LIMIT_PER_MINUTE=200

# HSTS max-age in seconds; 0 disables. Production HTTPS example: 31536000
# HSTS_MAX_AGE=0

# Cached merged settings payload (seconds)
# SETTINGS_CACHE_TTL=600

# Media library (backend/config/media.php) — optional overrides
# MEDIA_CONVERT_TO_WEBP=true
# MEDIA_WEBP_QUALITY=85

# Module toggles (projects, blog, media, …) are defined only in backend/config/features.php
# (not .env). GET /api/settings and GET /api/public/site-meta expose the effective flags.
